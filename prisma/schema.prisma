generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int     @id @default(autoincrement())
  name        String
  age         Int
  fitnessGoal String
  chats       Chat[]
}

model Chat {
  id        Int      @id @default(autoincrement())
  message   String
  reply     String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
}
